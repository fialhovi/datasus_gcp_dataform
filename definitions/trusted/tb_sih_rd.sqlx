config {
    type: "incremental",
    protected: true,
    schema: "trusted",
    description: "A trusted dataset derived from the raw.tb_sih_rd table, containing clean and structured hospital admission data from the SUS Hospital Information System (SIH)",
    tags: ["sih_rd"],
    columns: {
        municipality_code: docs.municipality_code,
        date: docs.date,
        year: docs.year,
        month: docs.month,
        specialty_bed: docs.specialty_bed,
        aih: docs.aih,
        type_aih: docs.type_aih,
        patient_municipality: docs.patient_municipality,
        gender: docs.gender,
        type_uti: docs.type_uti,
        days_hospitalized: docs.days_hospitalized,
        procedure: docs.procedure,
        total_value: docs.total_value,
        death: docs.death,
        risk_pregnant: docs.risk_pregnant,
        race_color: docs.race_color,
        birth_date: docs.birth_date,
        age: docs.age,
        date_loading: docs.date_loading
    },
    assertions: {
        uniqueKey: ["aih", "date"],
        nonNull: ["aih", "specialty_bed", "procedure"],
        rowConditions: [
            'LENGTH(municipality_code) = 6',
            'LENGTH(aih) = 13'
        ]
    },
    bigquery: {
        partitionBy: "date",
        updatePartitionFilter: "date >= DATE_SUB(CURRENT_DATE(), INTERVAL 3 MONTH)",
        clusterBy: ["procedure", "municipality_code"]
  },
}

  -- Defining the columns to be used in the project and the data type of each one
SELECT
  UF_ZI                                                                   AS municipality_code,
  SAFE_CAST(CONCAT(ANO_CMPT, "-", LPAD(MES_CMPT, 2, "0"), "-01") AS DATE) AS date,
  ANO_CMPT                                                                AS year,
  MES_CMPT                                                                AS month,
  ESPEC                                                                   AS specialty_bed,
  N_AIH                                                                   AS aih,
  IDENT                                                                   AS type_aih,
  MUNIC_RES                                                               AS patient_municipality,
  SEXO                                                                    AS gender,
  MARCA_UTI                                                               AS type_uti,
  CAST(QT_DIARIAS AS INT64)                                               AS days_hospitalized,
  PROC_REA                                                                AS procedure,
  CAST(VAL_TOT AS FLOAT64)                                                AS total_value,
  MORTE                                                                   AS death,
  GESTRISCO                                                               AS risk_pregnant,
  RACA_COR                                                                AS race_color,
  SAFE_CAST(PARSE_DATE('%Y%m%d', NASC) AS DATE)                           AS birth_date,
  DATE_DIFF(CURRENT_DATE("America/Sao_Paulo"),
    SAFE_CAST(PARSE_DATE('%Y%m%d', NASC) AS DATE), YEAR)                  AS age,
  TIMESTAMP(CURRENT_DATETIME("America/Sao_Paulo"))                        AS date_loading
FROM
  ${ref("raw", "tb_sih_rd")}

${when(incremental(), `WHERE TIMESTAMP(date_loading) > (SELECT MAX(date_loading) FROM ${self()})`) }
